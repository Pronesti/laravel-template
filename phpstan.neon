includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: max
    tmpDir: .phpstan.cache
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests
    excludePaths:
        # Generated by package:discover / config:cache — not source.
        - bootstrap/cache/*
